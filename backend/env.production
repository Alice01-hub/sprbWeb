# 生产环境配置 (Linux)
NODE_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# 数据库配置
DATABASE_PATH=./data/traffic_cards.db

# 服务器配置
HOST=0.0.0.0
PORT=8000
RELOAD=false

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,mp3,wav,ogg

# 简化配置 - 移除认证和复杂功能
ENABLE_AUTH=false
ENABLE_BUTTERFLY_SYSTEM=false
ENABLE_MONITORING=true

# 性能配置
WORKERS=4
